{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "COHORTome dataset manifest v1",
  "type": "object",
  "required": ["schema_version", "clinical"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "name": {"type": "string", "minLength": 1},
    "study_design": {"enum": ["cross_sectional", "longitudinal"]},
    "variants": {
      "type": "object",
      "required": ["schema_version", "annotations_file", "samples_file", "genotypes_file"],
      "properties": {
        "schema_version": {"type": "integer", "const": 1},
        "annotations_file": {"type": "string", "minLength": 1},
        "samples_file": {"type": "string", "minLength": 1},
        "genotypes_file": {"type": "string", "minLength": 1},
        "provenance": {
          "type": "object",
          "properties": {"technology": {"enum": ["dna_sequencing", "genotyping_array", "synthetic", ""]}},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "biosamples": {
      "type": "object",
      "required": ["file"],
      "properties": {"file": {"type": "string", "minLength": 1}}
    },
    "clinical": {
      "type": "object",
      "required": ["representation"],
      "properties": {"representation": {"enum": ["person", "snapshot"]}}
    },
    "identifiers": {
      "type": "object",
      "properties": {
        "clarid_biosamples": {
          "type": "object",
          "required": ["file", "codebook_version", "tools_version"],
          "properties": {
            "entity": {"const": "biosample"},
            "file": {"type": "string", "pattern": "\\S"},
            "delimiter": {"enum": [",", ";", "\t", "\\t"]},
            "codebook_version": {"type": "string", "pattern": "\\S"},
            "tools_version": {"type": "string", "pattern": "\\S"}
          }
        },
        "clarid_subjects": {
          "type": "object",
          "required": ["file", "codebook_version", "tools_version"],
          "properties": {
            "entity": {"const": "subject"},
            "file": {"type": "string", "pattern": "\\S"},
            "delimiter": {"enum": [",", ";", "\t", "\\t"]},
            "codebook_version": {"type": "string", "pattern": "\\S"},
            "tools_version": {"type": "string", "pattern": "\\S"}
          }
        }
      }
    }
  }
}
