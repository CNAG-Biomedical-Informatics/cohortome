# Copy to native.env, chmod 600 native.env, then edit once.
# Existing installations: retain your runtime, session secret and login settings.
# Use absolute host paths, not container paths. Values are literal (no $ expansion).
COHORTOME_RUNTIME_ROOT=/absolute/path/to/existing/runtime
COHORTOME_AUTH_MODE=local
COHORTOME_SESSION_SECRET=replace-with-your-existing-secret-or-generate-one-once
COHORTOME_HOST=127.0.0.1
COHORTOME_PORT=8001
COHORTOME_PUBLIC_BASE_URL=http://127.0.0.1:8001
COHORTOME_JOBS_REDIS_URL=redis://127.0.0.1:6379/0
COHORTOME_JOBS_QUEUE_NAME=analysis
LM_STUDIO_ENABLED=false
# Optional native analysis dependencies:
# COHORTOME_PHENO_RANKER_BIN=/opt/pheno-ranker/bin/pheno-ranker
# PERL5LIB=/absolute/path/to/perl5/lib/perl5
# R_LIBS_USER=/absolute/path/to/R/library
# Copy your existing OIDC/provider settings here when used.
