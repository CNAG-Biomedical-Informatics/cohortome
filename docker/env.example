# Copy to docker/.env and edit before starting the pilot deployment.

COHORTOME_AUTH_MODE=local
COHORTOME_SESSION_SECRET=change-this-to-a-long-random-secret
COHORTOME_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Compose sets this to /var/lib/cohortome, backed by the host runtime/ folder.
COHORTOME_RUNTIME_ROOT=/var/lib/cohortome

# Optional bootstrap users. Once runtime/state/auth/users.json exists, it
# becomes the source of truth and this seed is ignored.
COHORTOME_LOCAL_USERS_JSON=[{"username":"admin","password":"admin","role":"admin","display_name":"Administrator","groups":["admin"]},{"username":"mrueda","password":"mrueda","role":"user","display_name":"Manuel Rueda","groups":["cnag"]}]

# Branding shown in the app.
COHORTOME_BRAND_NAME=COHORTome
COHORTOME_BRAND_SUBTITLE=Clinical histories and multimodal assays, connected.
COHORTOME_HELP_URL=https://mrueda.github.io/cohortome/

# Background jobs.
COHORTOME_JOBS_REDIS_URL=redis://redis:6379/0

# LLM system default. Leave disabled until a reachable OpenAI-compatible
# endpoint is available from inside the containers.
LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT=45
LM_STUDIO_DATA_BOUNDARY=external

# Optional multi-provider registry. Prefer COHORTOME_LLM_PROVIDERS_FILE in production
# if the JSON becomes long.
COHORTOME_LLM_PROVIDERS_JSON=
COHORTOME_LLM_PROVIDERS_FILE=

# Pheno-Ranker is installed in the image from CPAN.
COHORTOME_PHENO_RANKER_BIN=/usr/local/bin/pheno-ranker

# Optional DICOM visualization. Start with:
# docker compose -f docker/docker-compose.yml --env-file docker/.env --profile dicom up -d --build
COHORTOME_DICOM_ENABLED=false
COHORTOME_OHIF_HOST_PORT=3000
COHORTOME_OHIF_PUBLIC_URL=http://127.0.0.1:3000
COHORTOME_DICOMWEB_PUBLIC_URL=http://127.0.0.1:8042/dicom-web
COHORTOME_ORTHANC_INTERNAL_URL=http://orthanc:8042
COHORTOME_ORTHANC_USERNAME=
COHORTOME_ORTHANC_PASSWORD=

# Optional password reset. For localhost pilots this can usually stay unset.
COHORTOME_SMTP_HOST=
COHORTOME_SMTP_PORT=587
COHORTOME_SMTP_FROM=
COHORTOME_SMTP_USERNAME=
COHORTOME_SMTP_PASSWORD=
COHORTOME_SMTP_TLS=true
