# Copy to docker/.env and edit before starting the pilot deployment.

BRN_AUTH_MODE=local
BRN_SESSION_SECRET=change-this-to-a-long-random-secret
BRN_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional bootstrap users. Once state/auth/users.json exists, it becomes the
# source of truth and this seed is ignored.
BRN_LOCAL_USERS_JSON=[{"username":"admin","password":"admin","role":"admin","display_name":"Administrator","groups":["admin"]},{"username":"mrueda","password":"mrueda","role":"user","display_name":"Manuel Rueda","groups":["cnag"]}]

# Branding shown in the app.
BRN_BRAND_NAME=Biomedical Research Navigator
BRN_BRAND_SUBTITLE=Clinical and molecular workspace exploration.
BRN_HELP_URL=https://mrueda.github.io/biomedical-research-navigator/

# Background jobs.
BRN_JOBS_REDIS_URL=redis://redis:6379/0

# LLM system default. Leave disabled until a reachable OpenAI-compatible
# endpoint is available from inside the containers.
LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT=45

# Optional multi-provider registry. Prefer BRN_LLM_PROVIDERS_FILE in production
# if the JSON becomes long.
BRN_LLM_PROVIDERS_JSON=
BRN_LLM_PROVIDERS_FILE=

# Pheno-Ranker is installed in the image from CPAN.
BRN_PHENO_RANKER_BIN=/usr/local/bin/pheno-ranker

# Optional DICOM visualization. Start with:
# docker compose -f docker/docker-compose.yml --env-file docker/.env --profile dicom up -d --build
BRN_DICOM_ENABLED=false
BRN_OHIF_HOST_PORT=3000
BRN_OHIF_PUBLIC_URL=http://127.0.0.1:3000
BRN_DICOMWEB_PUBLIC_URL=http://127.0.0.1:8042/dicom-web
BRN_ORTHANC_INTERNAL_URL=http://orthanc:8042
BRN_ORTHANC_USERNAME=
BRN_ORTHANC_PASSWORD=

# Optional password reset. For localhost pilots this can usually stay unset.
BRN_SMTP_HOST=
BRN_SMTP_PORT=587
BRN_SMTP_FROM=
BRN_SMTP_USERNAME=
BRN_SMTP_PASSWORD=
BRN_SMTP_TLS=true
