# Copy to docker/.env and edit before starting the pilot deployment.

PN_AUTH_MODE=local
PN_SESSION_SECRET=change-this-to-a-long-random-secret
PN_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional bootstrap users. Once state/auth/users.json exists, it becomes the
# source of truth and this seed is ignored.
PN_LOCAL_USERS_JSON=[{"username":"admin","password":"admin","role":"admin","display_name":"Administrator","groups":["admin"]},{"username":"mrueda","password":"mrueda","role":"user","display_name":"Manuel Rueda","groups":["cnag"]}]

# Branding shown in the app.
PN_BRAND_NAME=Patient Navigator
PN_BRAND_SUBTITLE=Clinical and molecular workspace exploration.
PN_HELP_URL=https://mrueda.github.io/patient-navigator/

# Background jobs.
PN_JOBS_REDIS_URL=redis://redis:6379/0

# LLM system default. Leave disabled until a reachable OpenAI-compatible
# endpoint is available from inside the containers.
LM_STUDIO_ENABLED=false
LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1
LM_STUDIO_MODEL=
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_TIMEOUT=45

# Optional multi-provider registry. Prefer PN_LLM_PROVIDERS_FILE in production
# if the JSON becomes long.
PN_LLM_PROVIDERS_JSON=
PN_LLM_PROVIDERS_FILE=

# Pheno-Ranker is installed in the image from CPAN.
PN_PHENO_RANKER_BIN=/usr/local/bin/pheno-ranker

# Optional password reset. For localhost pilots this can usually stay unset.
PN_SMTP_HOST=
PN_SMTP_PORT=587
PN_SMTP_FROM=
PN_SMTP_USERNAME=
PN_SMTP_PASSWORD=
PN_SMTP_TLS=true
