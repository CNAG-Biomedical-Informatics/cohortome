{
  "Name": "COHORTome Orthanc",
  "RemoteAccessAllowed": true,
  "AuthenticationEnabled": false,
  "HttpCorsEnabled": true,
  "DicomWeb": {
    "Enable": true,
    "Root": "/dicom-web/",
    "EnableWado": true,
    "WadoRoot": "/wado",
    "Ssl": false,
